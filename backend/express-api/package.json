{
  "name": "@hireflow/express-api",
  "version": "0.0.1",
  "private": true,
  "main": "dist/backend/express-api/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npx prisma@5.22.0 generate --schema=prisma/schema.prisma && tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/backend/express-api/src/server.js"
  },
  "dependencies": {
    "@hireflow/config": "workspace:*",
    "@hireflow/schemas": "workspace:*",
    "@prisma/client": "^5.14.0",
    "@supabase/supabase-js": "^2.43.4",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "@types/supertest": "^7.2.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^5.14.0",
    "supertest": "^7.2.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^2.1.9"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
